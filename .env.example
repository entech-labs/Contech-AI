# Copy this file to .env (setup.ps1 does it for you) and fill in the three <...> values.
# Never share .env or put it on GitHub — it holds your APS client secret.

# From your app in the APS developer portal (aps.autodesk.com/myapps)
APS_CLIENT_ID=<client ID from the APS portal>
APS_CLIENT_SECRET=<client secret from the APS portal>

# Must match the app's Callback URL in the APS portal exactly, including /callback
APS_CALLBACK_URL=http://localhost:5002/callback

# Your ACC project: the ID from the project's address bar, with "b." in front
DEFAULT_PROJECT_ID=b.<PROJECT-ID>
